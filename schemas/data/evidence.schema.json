{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-investors:data/evidence",
  "title": "evidence/v1 (evidence.json)",
  "description": "evidence_score.py output (DESIGN 4.8), keyed by report path.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:agent-investors:common_defs#/$defs/envelope"
    }
  ],
  "required": [
    "schema",
    "reports"
  ],
  "properties": {
    "schema": {
      "const": "evidence/v1"
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "agent_role",
          "ticker",
          "status",
          "score",
          "start",
          "floor",
          "deductions"
        ],
        "properties": {
          "agent_role": {
            "$ref": "urn:agent-investors:common_defs#/$defs/role_key"
          },
          "ticker": {
            "$ref": "urn:agent-investors:common_defs#/$defs/ticker_or_null"
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "start": {
            "type": "number"
          },
          "floor": {
            "type": "number"
          },
          "deductions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule",
                "points"
              ],
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "null_required | stale | few_sources | missing_data | ..."
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "points": {
                  "type": "number",
                  "maximum": 0
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
