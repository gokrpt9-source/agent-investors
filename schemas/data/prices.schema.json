{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-investors:data/prices",
  "title": "prices/v1 (phase1/prices.json)",
  "description": "fetch_prices.py output (DESIGN 4.1).",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:agent-investors:common_defs#/$defs/envelope"
    }
  ],
  "required": [
    "schema",
    "tickers",
    "failed",
    "fx"
  ],
  "properties": {
    "schema": {
      "const": "prices/v1"
    },
    "tickers": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:agent-investors:common_defs#/$defs/ticker"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ticker_prices"
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "{ticker: reason} for tickers no provider could serve."
    },
    "fx": {
      "type": "object",
      "required": [
        "usdils"
      ],
      "properties": {
        "usdils": {
          "$ref": "urn:agent-investors:common_defs#/$defs/fact_or_null"
        }
      },
      "additionalProperties": {
        "$ref": "urn:agent-investors:common_defs#/$defs/fact_or_null"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ticker_prices": {
      "type": "object",
      "required": [
        "last_close",
        "last_date",
        "first_date",
        "rows",
        "provider",
        "stale",
        "adv_usd_63d",
        "returns_pct",
        "series_path"
      ],
      "properties": {
        "last_close": {
          "$ref": "urn:agent-investors:common_defs#/$defs/fact"
        },
        "last_date": {
          "$ref": "urn:agent-investors:common_defs#/$defs/date"
        },
        "first_date": {
          "$ref": "urn:agent-investors:common_defs#/$defs/date"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "enum": [
            "yfinance",
            "stooq",
            "cache_stale"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "adv_usd_63d": {
          "$ref": "urn:agent-investors:common_defs#/$defs/fact"
        },
        "returns_pct": {
          "type": "object",
          "required": [
            "1m",
            "3m",
            "6m",
            "12m"
          ],
          "properties": {
            "1m": {
              "$ref": "urn:agent-investors:common_defs#/$defs/fact"
            },
            "3m": {
              "$ref": "urn:agent-investors:common_defs#/$defs/fact"
            },
            "6m": {
              "$ref": "urn:agent-investors:common_defs#/$defs/fact"
            },
            "12m": {
              "$ref": "urn:agent-investors:common_defs#/$defs/fact"
            }
          },
          "additionalProperties": true
        },
        "series_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
