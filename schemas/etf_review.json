{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-investors:etf_review",
  "title": "ETF review",
  "description": "etf-analyst output for a fund holding (DESIGN 5).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "order_id",
    "agent_role",
    "sector",
    "ticker",
    "as_of",
    "sources",
    "missing_data",
    "red_flags",
    "self_evidence",
    "self_evidence_reason",
    "thesis",
    "stance",
    "lookthrough_summary",
    "expense_ratio_pct",
    "top10_concentration_pct",
    "overlap",
    "momentum_vs_benchmark",
    "role_in_portfolio",
    "conviction",
    "conviction_reason",
    "action",
    "key_figures",
    "invalidation_price"
  ],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "$ref": "urn:agent-investors:common_defs#/$defs/comment"
    },
    "schema_version": {
      "$ref": "urn:agent-investors:common_defs#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "urn:agent-investors:common_defs#/$defs/run_id"
    },
    "order_id": {
      "$ref": "urn:agent-investors:common_defs#/$defs/order_id"
    },
    "agent_role": {
      "const": "etf"
    },
    "sector": {
      "$ref": "urn:agent-investors:common_defs#/$defs/sector_key"
    },
    "ticker": {
      "$ref": "urn:agent-investors:common_defs#/$defs/ticker"
    },
    "as_of": {
      "$ref": "urn:agent-investors:common_defs#/$defs/date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/source"
      }
    },
    "missing_data": {
      "$ref": "urn:agent-investors:common_defs#/$defs/missing_data"
    },
    "red_flags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/red_flag"
      }
    },
    "flag_responses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/flag_response"
      },
      "description": "Responses to other agents' flags (optional)."
    },
    "self_evidence": {
      "$ref": "urn:agent-investors:common_defs#/$defs/score_1_10",
      "description": "Agent's own view of data completeness (recorded only; decisions use the rule-based evidence score)."
    },
    "self_evidence_reason": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
      "description": "Why that self-evidence score (<= 60 words)"
    },
    "thesis": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
      "description": "Why the fund is (or is not) earning its place (<= 60 words)"
    },
    "stance": {
      "$ref": "urn:agent-investors:common_defs#/$defs/stance"
    },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/strength"
      },
      "description": "Optional; up to 3."
    },
    "risks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/risk"
      },
      "description": "Optional; up to 3."
    },
    "lookthrough_summary": {
      "type": "object",
      "required": [
        "top_sectors",
        "data_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "top_sectors": {
          "type": "array",
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": [
              "sector",
              "pct"
            ],
            "additionalProperties": false,
            "properties": {
              "sector": {
                "$ref": "urn:agent-investors:common_defs#/$defs/sector_or_cash"
              },
              "pct": {
                "$ref": "urn:agent-investors:common_defs#/$defs/pct_0_100"
              }
            }
          }
        },
        "data_ref": {
          "anyOf": [
            {
              "$ref": "urn:agent-investors:common_defs#/$defs/data_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "expense_ratio_pct": {
      "$ref": "urn:agent-investors:common_defs#/$defs/pct_or_null"
    },
    "top10_concentration_pct": {
      "$ref": "urn:agent-investors:common_defs#/$defs/pct_or_null"
    },
    "overlap": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "with",
          "overlap_pct",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "with": {
            "$ref": "urn:agent-investors:common_defs#/$defs/ticker"
          },
          "overlap_pct": {
            "$ref": "urn:agent-investors:common_defs#/$defs/pct_or_null"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "e.g. top10, direct_holding"
          }
        }
      }
    },
    "momentum_vs_benchmark": {
      "type": "object",
      "required": [
        "benchmark",
        "rs_3m",
        "rs_6m",
        "rs_12m"
      ],
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "$ref": "urn:agent-investors:common_defs#/$defs/ticker"
        },
        "rs_3m": {
          "type": [
            "number",
            "null"
          ],
          "description": "excess return, pp"
        },
        "rs_6m": {
          "type": [
            "number",
            "null"
          ]
        },
        "rs_12m": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "role_in_portfolio": {
      "enum": [
        "core",
        "satellite",
        "factor_tilt",
        "hedge",
        "redundant"
      ]
    },
    "conviction": {
      "$ref": "urn:agent-investors:common_defs#/$defs/score_1_10"
    },
    "conviction_reason": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
      "description": "Why that conviction (<= 60 words)"
    },
    "action": {
      "$ref": "urn:agent-investors:common_defs#/$defs/holding_action"
    },
    "key_figures": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/key_figure"
      }
    },
    "invalidation_price": {
      "$ref": "urn:agent-investors:common_defs#/$defs/price_or_null"
    },
    "invalidation_rationale": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
      "description": "What would prove the view wrong (<= 60 words)"
    }
  }
}
