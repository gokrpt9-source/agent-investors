{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-investors:macro_view",
  "title": "Macro view",
  "description": "macro-geopolitics output (phase 1). Scenario probabilities must sum to 1 +/- 0.01 and min_weight <= max_weight (semantic checks).",
  "type": "object",
  "required": [
    "run_id",
    "order_id",
    "agent_role",
    "as_of",
    "regime",
    "regime_summary",
    "drivers",
    "scenarios",
    "sector_constraints",
    "conviction",
    "conviction_reason",
    "key_figures",
    "sources",
    "missing_data"
  ],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "$ref": "urn:agent-investors:common_defs#/$defs/comment"
    },
    "schema_version": {
      "$ref": "urn:agent-investors:common_defs#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "urn:agent-investors:common_defs#/$defs/run_id"
    },
    "order_id": {
      "$ref": "urn:agent-investors:common_defs#/$defs/order_id"
    },
    "agent_role": {
      "const": "macro"
    },
    "as_of": {
      "$ref": "urn:agent-investors:common_defs#/$defs/date"
    },
    "regime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "x-max-words": 8,
      "description": "Short regime label (<= 8 words), e.g. 'late-cycle disinflation'."
    },
    "regime_summary": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_80w",
      "description": "Regime summary (<= 80 words)"
    },
    "drivers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "driver",
          "direction",
          "series",
          "data_refs",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "driver": {
            "$ref": "urn:agent-investors:common_defs#/$defs/text_40w",
            "description": "Driver, tied to fetched data (<= 40 words)"
          },
          "direction": {
            "enum": [
              "tailwind",
              "headwind",
              "neutral",
              "mixed"
            ],
            "description": "Effect on US equities overall."
          },
          "series": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "description": "FRED series ids (e.g. DGS10)."
          },
          "data_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:agent-investors:common_defs#/$defs/data_ref"
            }
          },
          "source_ids": {
            "$ref": "urn:agent-investors:common_defs#/$defs/source_ids_min1"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "probability",
          "description",
          "sector_implications"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
            "description": "Scenario (<= 60 words)"
          },
          "sector_implications": {
            "type": "array",
            "maxItems": 11,
            "items": {
              "type": "object",
              "required": [
                "sector",
                "impact"
              ],
              "additionalProperties": false,
              "properties": {
                "sector": {
                  "$ref": "urn:agent-investors:common_defs#/$defs/gics_sector"
                },
                "impact": {
                  "enum": [
                    "positive",
                    "negative",
                    "neutral"
                  ]
                },
                "note": {
                  "$ref": "urn:agent-investors:common_defs#/$defs/text_25w"
                }
              }
            }
          }
        }
      }
    },
    "sector_constraints": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "sector",
          "min_weight",
          "max_weight",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "sector": {
            "$ref": "urn:agent-investors:common_defs#/$defs/gics_or_cash"
          },
          "min_weight": {
            "$ref": "urn:agent-investors:common_defs#/$defs/pct_0_100"
          },
          "max_weight": {
            "$ref": "urn:agent-investors:common_defs#/$defs/pct_0_100"
          },
          "rationale": {
            "$ref": "urn:agent-investors:common_defs#/$defs/text_40w",
            "description": "Why this floor/cap (<= 40 words)"
          }
        }
      }
    },
    "conviction": {
      "$ref": "urn:agent-investors:common_defs#/$defs/score_1_10"
    },
    "conviction_reason": {
      "$ref": "urn:agent-investors:common_defs#/$defs/text_60w",
      "description": "Why that conviction (<= 60 words)"
    },
    "key_figures": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/key_figure"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:agent-investors:common_defs#/$defs/source"
      }
    },
    "missing_data": {
      "$ref": "urn:agent-investors:common_defs#/$defs/missing_data"
    }
  }
}
