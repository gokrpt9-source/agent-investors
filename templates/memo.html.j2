.badge { display: inline-block; padding: 0 .5rem; border-radius: 999px; font-size: .78rem; font-weight: 700;
  letter-spacing: .02em; border: 1px solid currentColor; white-space: nowrap; }
.b-pos { color: var(--pos); } .b-neg { color: var(--neg); } .b-warn { color: var(--warn); }
.b-neutral { color: var(--neutral); } .b-mute { color: var(--mute); }
