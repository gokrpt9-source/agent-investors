</style>
</head>
<body>
<div class="page">
<header class="memo-header">
<h1>{{ memo.title }}</h1>
<p class="subtitle">{{ memo.subtitle }}</p>
{% if memo.chair_status %}
<p class="muted">{{ memo.chair_status }}</p>
{% endif %}
</header>
<main>
{% if memo.chair %}
<section id="chair" class="chair chair-{{ memo.chair.verdict_class }}" aria-label="{{ memo.chair.title }}">
<h2>{{ memo.chair.title }}</h2>
<p class="chair-verdict"><span class="badge {{ memo.chair.verdict_class }}">{{ memo.chair.verdict_label }}</span>{% if memo.chair.meta %}<span class="muted">{{ memo.chair.meta }}</span>{% endif %}</p>
{% if memo.chair.headline %}
<p class="chair-headline">{{ memo.chair.headline }}</p>
{% endif %}
{% for b in memo.chair.blocks %}
{{ html_block(b) }}
{% endfor %}
</section>
{% endif %}
{% for s in memo.sections %}
<section id="{{ s.anchor }}">
<h2>{{ s.title }}</h2>
{% for b in s.blocks %}
{{ html_block(b) }}
{% endfor %}
</section>
{% if loop.first and memo.sections|length > 1 %}
<nav class="toc" aria-label="Contents">
<ol>
{% for t in memo.sections[1:] %}
<li><a href="#{{ t.anchor }}">{{ t.title }}</a></li>
{% endfor %}
</ol>
</nav>
{% endif %}
{% endfor %}
</main>
<footer>
<p>{{ memo.disclaimer }}</p>
<p>Generated {{ memo.generated_at }} by scripts/render_memo.py.</p>
</footer>
</div>
</body>
</html>
