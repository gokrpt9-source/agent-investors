{#- memo.html.j2 — Investment Committee memo, self-contained HTML (DESIGN §4.14).
    Rendered by scripts/render_memo.py with autoescape=True. Inline CSS only: no scripts, no
    external stylesheets, fonts or images. Light and dark themes via prefers-color-scheme; print
    styles force the light palette. Links are emitted only for plain http(s) URLs (safe_url). -#}
{% macro html_block(b, lvl=3) %}
{% if b.type == "para" %}
<p class="{{ b.style }}">{{ b.text }}</p>
{% elif b.type == "subheading" %}
<h{{ lvl }}>{{ b.text }}</h{{ lvl }}>
{% elif b.type == "bullets" %}
<ul>
{% for it in b.entries %}
<li>{{ it }}</li>
{% endfor %}
</ul>
{% elif b.type == "kv" %}
<dl class="kv">
{% for pair in b.entries %}
<dt>{{ pair[0] }}</dt><dd>{{ pair[1] }}</dd>
{% endfor %}
</dl>
{% elif b.type == "table" %}
<div class="table-wrap">
<table>
{% if b.caption %}<caption>{{ b.caption }}</caption>{% endif %}
<thead><tr>{% for h in b.headers %}{% set cls = b.align[loop.index0]|align_class %}<th{% if cls %} class="{{ cls }}"{% endif %} scope="col">{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in b.rows %}
<tr>{% set ri = loop.index0 %}{% for c in r %}{% set i = loop.index0 %}{% set cls = b.align[i]|align_class %}{% set tip = b.titles[ri ~ ":" ~ i] if b.titles else "" %}<td{% if cls %} class="{{ cls }}"{% endif %}{% if tip %} title="{{ tip }}"{% endif %}>{% if i in b.links and (c|safe_url) %}<a href="{{ c|safe_url }}" rel="noopener noreferrer">{{ c }}</a>{% elif i in b.badges and (c|badge_class) %}<span class="badge {{ c|badge_class }}">{{ c }}</span>{% else %}{{ c|cell_html }}{% endif %}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
</div>
{% elif b.type == "card" %}
<article class="card">
<h{{ lvl }} class="card-title">{{ b.title }}</h{{ lvl }}>
{% for c in b.blocks %}
{{ html_block(c, lvl + 1) }}
{% endfor %}
</article>
{% endif %}
{% endmacro %}
