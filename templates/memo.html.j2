@media print {
  :root {
    --bg: #ffffff; --fg: #000000; --muted: #444444; --border: #bbbbbb; --th: #eeeeee; --stripe: #ffffff;
    --card: #ffffff; --accent: #000000; --link: #000000; --warn-bg: #ffffff; --warn-fg: #000000;
    --warn-border: #888888; --disc-bg: #ffffff; --disc-fg: #000000; --disc-border: #000000;
    --pos: #000000; --neg: #000000; --warn: #000000; --neutral: #000000; --mute: #444444;
  }
  body { font-size: 10.5pt; }
  .page { max-width: none; padding: 0; }
  nav.toc { display: none; }
  .table-wrap { overflow: visible; }
  h2, h3, h4 { break-after: avoid; page-break-after: avoid; }
  tr, .card, .chair, dl.kv { break-inside: avoid; page-break-inside: avoid; }
