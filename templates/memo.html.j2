    --bg: #121418; --fg: #e3e6ea; --muted: #9aa3af; --border: #30363f; --th: #1b1f25;
    --stripe: #16191e; --card: #171a20; --accent: #8aa9ff; --link: #8aa9ff;
    --warn-bg: #33270c; --warn-fg: #f3d189; --warn-border: #7a5a14;
    --disc-bg: #1a2140; --disc-fg: #cdd6ff; --disc-border: #8aa9ff;
    --pos: #5fd38d; --neg: #ff8a80; --warn: #f5b759; --neutral: #b4bcc8; --mute: #9aa3af;
