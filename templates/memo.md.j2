{% macro md_block(b, lvl=3) %}
{% if b.type == "para" %}
{% if b.style == "disclaimer" %}
> **{{ b.text|md_text }}**
{% elif b.style == "warn" %}
> **Note:** {{ b.text|md_text }}
{% elif b.style == "muted" %}
_{{ b.text|md_text }}_
{% else %}
{{ b.text|md_text }}
{% endif %}

{% elif b.type == "subheading" %}
{{ "#" * lvl }} {{ b.text|md_text }}

{% elif b.type == "bullets" %}
{% for it in b.entries %}
- {{ it|md_text }}
{% endfor %}

{% elif b.type == "kv" %}
{% for pair in b.entries %}
- **{{ pair[0]|md_text }}:** {{ pair[1]|md_text }}
{% endfor %}

{% elif b.type == "table" %}
{% if b.caption %}
**{{ b.caption|md_text }}**

{% endif %}
{{ b.headers|md_row }}
{{ b.align|md_sep(b.headers|length) }}
{% for r in b.rows %}
{{ r|md_row }}
{% endfor %}

{% elif b.type == "card" %}
{{ "#" * lvl }} {{ b.title|md_text }}

{% for c in b.blocks %}
{{ md_block(c, lvl + 1) }}
{% endfor %}

{% endif %}
{% endmacro %}
# {{ memo.title|md_text }}

_{{ memo.subtitle|md_text }}_

{% if memo.chair_status %}
_{{ memo.chair_status|md_text }}_

